<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:clipToOutline="true">
  <ImageView android:id="@+id/bg_color" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_fill" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <ImageView android:id="@+id/bg_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/art" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" android:background="@drawable/art_round" android:clipToOutline="true" android:contentDescription="Album art"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp" android:orientation="vertical">
      <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Wavelength"/>
      <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="Tap to open"/>
    </LinearLayout>
    <ImageView android:id="@+id/prev" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/ic_prev" android:background="@drawable/btn_ripple" android:contentDescription="Previous" android:scaleType="fitCenter"/>
    <ImageView android:id="@+id/play" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_play" android:background="@drawable/play_circle" android:contentDescription="Play" android:scaleType="fitCenter"/>
    <ImageView android:id="@+id/next" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/ic_next" android:background="@drawable/btn_ripple" android:contentDescription="Next" android:scaleType="fitCenter"/>
  </LinearLayout>
</FrameLayout>
