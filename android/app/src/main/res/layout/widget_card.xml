<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:clipToOutline="true">
  <ImageView android:id="@+id/bg_color" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_fill" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <ImageView android:id="@+id/bg_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/art" android:layout_width="84dp" android:layout_height="84dp" android:scaleType="centerCrop" android:background="@drawable/art_round" android:clipToOutline="true" android:contentDescription="Album art"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="10sp" android:letterSpacing="0.12" android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" android:text="Now playing"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Wavelength"/>
      <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:text="Tap to open"/>
      </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_height="4dp" android:max="1000" android:progress="0" android:progressTint="#FFFFFFFF" android:progressBackgroundTint="#55FFFFFF" android:layout_width="match_parent" android:layout_marginTop="10dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/like" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_heart" android:background="@drawable/btn_ripple" android:contentDescription="Like" android:scaleType="fitCenter"/>
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      <ImageView android:id="@+id/prev" android:layout_width="42dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_prev" android:background="@drawable/btn_ripple" android:contentDescription="Previous" android:scaleType="fitCenter"/>
      <FrameLayout android:layout_width="10dp" android:layout_height="1dp"/>
      <ImageView android:id="@+id/play" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_play" android:background="@drawable/play_circle" android:contentDescription="Play" android:scaleType="fitCenter"/>
      <FrameLayout android:layout_width="10dp" android:layout_height="1dp"/>
      <ImageView android:id="@+id/next" android:layout_width="42dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_next" android:background="@drawable/btn_ripple" android:contentDescription="Next" android:scaleType="fitCenter"/>
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      <ImageView android:id="@+id/radio" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_radio" android:background="@drawable/btn_ripple" android:contentDescription="Start radio" android:scaleType="fitCenter"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
